# =====================================================================
# Configuration IAI-Gestion (Environnement de Production / Développement)
# Centre d'Excellence IAI-Cameroun - Douala
# =====================================================================

# ---------------------------------------------------------------------
# 1. Django - Sécurité & Base
# ---------------------------------------------------------------------
SECRET_KEY=django-insecure-votre-cle-secrete-production-ici
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,iai-gestion.cm,www.iai-gestion.cm

# ---------------------------------------------------------------------
# 2. Base de données (PostgreSQL recommandée en Production)
# ---------------------------------------------------------------------
# Pour PostgreSQL (Production) :
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=iai_gestion
DATABASE_USER=postgres
DATABASE_PASSWORD=votre_mot_de_passe_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=600

# Pour SQLite (Développement local uniquement) :
# DATABASE_ENGINE=django.db.backends.sqlite3
# DATABASE_NAME=db.sqlite3

# ---------------------------------------------------------------------
# 3. CinetPay - Paiements Mobile Money (MTN & Orange Money)
# ---------------------------------------------------------------------
# Créez votre compte marchand sur https://www.cinetpay.com
CINETPAY_API_KEY=votre_api_key_cinetpay_reelle
CINETPAY_SITE_ID=votre_site_id_cinetpay
CINETPAY_SECRET_KEY=votre_secret_key_cinetpay
# CINETPAY_MODE=LIVE (en production pour encaisser l'argent réel) | SANDBOX (pour tests)
CINETPAY_MODE=LIVE
SITE_BASE_URL=https://votre-domaine-public.cm

# ---------------------------------------------------------------------
# 4. Service d'Envoi d'E-mails (SMTP Gmail / Brevo / Mailjet)
# ---------------------------------------------------------------------
# Exemple Gmail (Mot de passe d'application 16 caractères requis)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_BYPASS_SSL=True
EMAIL_HOST_USER=votre-email-expediteur@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=IAI-Cameroun Douala <votre-email-expediteur@gmail.com>
ADMIN_EMAIL=admin@iai-cameroun.cm

# ---------------------------------------------------------------------
# 5. WhatsApp Multicanal (Meta Cloud API / CallMeBot / Gateway Pro)
# ---------------------------------------------------------------------
# Meta WhatsApp Cloud API (Officiel) :
WHATSAPP_META_TOKEN=votre_token_meta_whatsapp_cloud_api
WHATSAPP_META_PHONE_NUMBER_ID=votre_phone_number_id_meta
# URL générée automatiquement ou personnalisée pour passerelle HTTP
# WHATSAPP_API_URL=https://graph.facebook.com/v18.0/votre_phone_number_id/messages

# ---------------------------------------------------------------------
# 6. OCR & Reconnaissance de Reçus Bancaires (Optionnel)
# ---------------------------------------------------------------------
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
